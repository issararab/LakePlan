LLM_PROVIDER=databricks

# Databricks (default provider)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_personal_access_token
DATABRICKS_LLM_ENDPOINT=your-model-endpoint

# Anthropic (local dev only — set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=your_api_key
# ANTHROPIC_MODEL=claude-opus-4-5

# Open-weight models on any OpenAI-compatible server — set LLM_PROVIDER=openai_compatible to use.
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=qwen2.5:7b
# vLLM:    OPENAI_BASE_URL=http://localhost:8001/v1    OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
# OPENAI_API_KEY=only-if-your-server-checks-one

# Optional overrides
# DUCKDB_PATH=data/pricing.duckdb
# MAX_ROWS=100
# LOG_LEVEL=INFO
