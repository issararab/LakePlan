%% Source for docs/agents-turn.svg. Regenerate with:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i docs/agents-turn.mmd -o docs/agents-turn.svg -c docs/mermaid.json -b white
sequenceDiagram
    autonumber
    actor C as Customer
    participant G as LangGraph
    participant A as Architect
    participant P as Planner
    participant S as SQL analyst
    participant Y as Synthesizer

    C->>G: "Yes, approve"
    G->>A: START → architect
    A-->>G: goto planner (brief)
    G->>P: run planner
    P-->>G: goto sql_analyst (lookups)
    G->>S: run sql_analyst
    Note over S: write SQL → validate → run on DuckDB
    S-->>G: goto synthesizer (rows)
    G->>Y: run synthesizer
    Y-->>G: goto respond (estimate)
    Note over G: respond saves the turn to the session thread
    G->>C: estimate (agent = synthesizer)
